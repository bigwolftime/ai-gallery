# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
# Flutter/Gradle generate build directories in the app and native plugins.
**/build/
/coverage/
.ota-command.lock

# Model weights are downloaded by the app; keep only the JSON manifest in Git.
*.litertlm
*.litertlm.gz

# Generated installation packages, archives and debug symbols.
*.ipa
*.apk
*.aab
*.xcarchive/
*.dSYM/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Deliverables are generated by the build/packaging workflow.
/dist/
