<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Store clients install updates; store builds cannot request APK installs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <application android:icon="@mipmap/ic_launcher_store" tools:replace="android:icon">
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.ai_gallery.updates" tools:node="remove" />
        <meta-data android:name="ai_gallery.distribution_channel" android:value="${aiGalleryDistribution}" />
    </application>
</manifest>
